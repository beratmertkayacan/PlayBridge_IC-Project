# Bu dosyayı .env olarak kopyalayıp gerçek anahtarınızı girin:
#   cp .env.example .env
#
# .env dosyası ASLA Git'e eklenmemeli — .gitignore zaten bunu engelliyor.
#
# Ücretsiz Gemini API anahtarınızı buradan alın (kredi kartı istemiyor):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Yerel Postgres (docker compose up -d ile ayağa kalkar)
DATABASE_URL=postgresql+psycopg2://playbridge:playbridge@127.0.0.1:5432/playbridge

# Ücretsiz kota PROJE ve MODEL başına ayrı sayılıyor (günde 20 istek).
# Kota dolduğunda kod değiştirmeye gerek yok: buradan başka bir modele
# geçip sunucuyu yeniden başlatmanız yeterli.
#   Çalışan alternatifler: gemini-3.5-flash, gemini-3.6-flash,
#   gemini-3.7-flash, gemini-3.1-flash-lite, gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.5-flash
# Güvenlik incelemesi bilerek FARKLI bir model: iki çağrı ayrı
# kotalardan yediği için günlük kapasite ikiye katlanıyor.
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
